POSTGRES_USER=envelo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=envelo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_STATEMENT_FORMATS=csv
STATEMENT_UPLOAD_DIR=/app/files

LOG_LEVEL=INFO

# Signs every access token: anyone who has it can log in as anyone. At least 32
# characters, or the API refuses to start - which this placeholder deliberately
# is not, so a copied-unchanged .env fails loudly instead of running with a
# secret published in the repo. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30